{
  "name": "Thinking Functionally JVM",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteEnv": {
    "JAVA_HOME": "/usr/local/sdkman/candidates/java/21.0.4-zulu",
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "scalameta.metals"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "interactive",
        "metals.javaVersion": "21",
        "metals.javaHome": "/usr/local/sdkman/candidates/java/21.0.4-zulu",
        "terminal.integrated.env.linux": {
          "JAVA_HOME": "/usr/local/sdkman/candidates/java/26-zulu",
          "PATH": "/usr/local/sdkman/candidates/java/26-zulu/bin:${env:PATH}"
        }
      }
    }
  },
  "postCreateCommand": "java -version && mvn -version && gradle -version && sbt --version"
}
