{
  "name": "Thinking Functionally JVM",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "remoteEnv": {
    "JAVA_HOME": "/opt/java/jdk-21"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "scalameta.metals"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/opt/java/jdk-21",
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-21",
            "path": "/opt/java/jdk-21"
          },
          {
            "name": "JavaSE-26",
            "path": "/opt/java/jdk-26",
            "default": true
          }
        ],
        "java.configuration.updateBuildConfiguration": "interactive",
        "metals.javaVersion": "21",
        "metals.javaHome": "/opt/java/jdk-21",
        "metals.defaultBspToBuildTool": true,
        "terminal.integrated.env.linux": {
          "JAVA_HOME": "/opt/java/jdk-26"
        }
      }
    }
  },
  "postCreateCommand": "export JAVA_HOME=/opt/java/jdk-26 && java -version && mvn -version && gradle -version && sbt --version"
}
