{
  "name": "Thinking Functionally JVM",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "scalameta.metals"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "interactive",
        "metals.javaHome": "/usr/local/sdkman/candidates/java/current"
      }
    }
  },
  "postCreateCommand": "java -version && mvn -version && gradle -version && sbt --version"
}
